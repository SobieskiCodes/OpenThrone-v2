generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Models ──────────────────────────────────────────────────────────────────
// Note: Enums are enforced at the application layer (Zod schemas + TypeScript enums
// in @openthrone/shared). This keeps the schema portable across SQLite, PostgreSQL,
// MySQL, etc. When deploying to PostgreSQL, you can optionally re-add native enums.

model Player {
  id            String   @id @default(uuid())
  email         String   @unique
  display_name  String   @unique
  password_hash String
  race          String   // PlayerRace: UNDEAD, HUMAN, GOBLIN, ELF
  player_class  String   @map("class") // PlayerClass: FIGHTER, CLERIC, ASSASSIN, THIEF
  locale        String   @default("en-US")
  avatar        String?  @default("SHIELD")
  bio           String   @default("")
  color_scheme  String?
  recruit_link  String   @unique @default(uuid())
  status        String   @default("ACTIVE") // AccountStatus
  last_active   DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  economy             PlayerEconomy?
  units               PlayerUnit[]
  items               PlayerItem[]
  battle_upgrades     PlayerBattleUpgrade[]
  structure_upgrades  PlayerStructureUpgrade[]
  fortification       PlayerFortification?
  buildings           PlayerBuilding[]
  bonus_points        PlayerBonusPoint[]
  stats               PlayerStats?
  cumulative_stats    PlayerCumulativeStats?

  attacks_made        AttackLog[]          @relation("attacker")
  attacks_received    AttackLog[]          @relation("defender")
  attack_log_acl      AttackLogAcl[]

  recruit_history_from RecruitHistory[]    @relation("recruit_from")
  recruit_history_to   RecruitHistory[]    @relation("recruit_to")

  social_initiated    Social[]             @relation("social_player")
  social_received     Social[]             @relation("social_friend")

  alliance_led        Alliance[]           @relation("alliance_leader")
  alliance_membership AllianceMembership[]

  permission_grants   PermissionGrant[]
  password_resets     PasswordReset[]

  status_history      AccountStatusHistory[] @relation("status_user")
  admin_actions       AccountStatusHistory[] @relation("status_admin")

  blog_posts          BlogPost[]
  post_read_status    PostReadStatus[]

  chat_rooms_created  ChatRoom[]
  chat_participants   ChatRoomParticipant[]
  chat_messages       ChatMessage[]
  chat_reactions      ChatMessageReaction[]
  chat_read_status    ChatMessageReadStatus[]

  cosmetics           PlayerCosmetic[]

  mail_sent           Mail[]
  mail_received       MailRecipient[]

  saved_simulations   SavedSimulation[]

  mercenary_purchases MercenaryDailyPurchase[]

  intel_targets  AllianceIntel[] @relation("intel_target")
  intel_gathered AllianceIntel[] @relation("intel_spy")

  activities_performed ActivityLog[] @relation("activity_actor")
  activities_targeted  ActivityLog[] @relation("activity_target")

  ranking_snapshots RankingSnapshot[]

  is_bot     Boolean @default(false)
  bot_config BotConfig?

  // Bot Intelligence (Phase 1)
  bot_intel_cache    BotIntelCache[]    @relation("BotIntelReports")
  bot_battle_memory  BotBattleMemory[]  @relation("BotBattleHistory")
  bot_threats        BotThreatTracking[] @relation("BotThreats")

  @@index([created_at])
  @@map("players")
}

model PlayerEconomy {
  id            Int    @id @default(autoincrement())
  player_id     String @unique
  gold          BigInt @default(25000)
  gold_in_bank  BigInt @default(0)
  attack_turns  Int    @default(50)
  house_level   Int    @default(0)
  economy_level     Int       @default(0)
  last_auto_recruit DateTime?

  player Player @relation(fields: [player_id], references: [id])

  @@map("player_economy")
}

model PlayerUnit {
  id        Int    @id @default(autoincrement())
  player_id String
  unit_type String // UnitType: CITIZEN, WORKER, OFFENSE, DEFENSE, SPY, SENTRY
  level     Int
  quantity  Int    @default(0)

  player Player @relation(fields: [player_id], references: [id])

  @@unique([player_id, unit_type, level])
  @@index([player_id])
  @@map("player_units")
}

model PlayerItem {
  id        Int    @id @default(autoincrement())
  player_id String
  item_type String // ItemType: WEAPON, HELM, ARMOR, BOOTS, BRACERS, SHIELD
  usage     String // ItemUsage: OFFENSE, DEFENSE, SPY, SENTRY
  level     Int
  quantity  Int    @default(0)

  player Player @relation(fields: [player_id], references: [id])

  @@unique([player_id, item_type, usage, level])
  @@index([player_id])
  @@map("player_items")
}

model PlayerBattleUpgrade {
  id           Int    @id @default(autoincrement())
  player_id    String
  upgrade_type String // BattleUpgradeType: OFFENSE, DEFENSE, SPY, SENTRY
  level        Int    @default(1)
  quantity     Int    @default(0)

  player Player @relation(fields: [player_id], references: [id])

  @@unique([player_id, upgrade_type, level])
  @@index([player_id])
  @@map("player_battle_upgrades")
}

model PlayerStructureUpgrade {
  id           Int    @id @default(autoincrement())
  player_id    String
  upgrade_type String // StructureUpgradeType: OFFENSE, SPY, SENTRY, ARMORY
  level        Int    @default(1)

  player Player @relation(fields: [player_id], references: [id])

  @@unique([player_id, upgrade_type])
  @@index([player_id])
  @@map("player_structure_upgrades")
}

model PlayerFortification {
  id        Int    @id @default(autoincrement())
  player_id String @unique
  fort_level Int   @default(1)
  hitpoints  Int   @default(50)

  player Player @relation(fields: [player_id], references: [id])

  @@map("player_fortification")
}

model PlayerBuilding {
  id            Int    @id @default(autoincrement())
  player_id     String
  building_type String // BuildingType: FORTIFICATION, ARMORY, MINE, SPY_ACADEMY, HOUSING, MERCENARY_CAMP
  level         Int    @default(0)

  player Player @relation(fields: [player_id], references: [id])

  @@unique([player_id, building_type])
  @@index([player_id])
  @@map("player_buildings")
}

model PlayerBonusPoint {
  id         Int    @id @default(autoincrement())
  player_id  String
  bonus_type String // BonusPointType: OFFENSE, DEFENSE, INTEL, PRICES, INCOME
  level      Int    @default(0)

  player Player @relation(fields: [player_id], references: [id])

  @@unique([player_id, bonus_type])
  @@index([player_id])
  @@map("player_bonus_points")
}

model PlayerStats {
  id            Int      @id @default(autoincrement())
  player_id     String   @unique
  experience    BigInt   @default(0)
  rank          Int      @default(0)
  previous_rank Int      @default(0) // Rank from last daily snapshot (for movement arrows)
  offense       Int      @default(0)
  defense       Int      @default(0)
  spy           Int      @default(0)
  sentry        Int      @default(0)
  killing_str   Int      @default(1)
  defense_str   Int      @default(1)
  spying_str    Int      @default(1)
  sentry_str    Int      @default(1)
  updated_at    DateTime @updatedAt

  player Player @relation(fields: [player_id], references: [id])

  @@map("player_stats")
}

model RankingSnapshot {
  id            Int      @id @default(autoincrement())
  player_id     String
  category      String   // 'overall', 'offense', 'defense', 'spy', 'sentry', 'netWorth'
  rank          Int
  score         Int      // Stat value or calculated score
  snapshot_date DateTime @default(now()) // Snapshots at midnight UTC (date only, stored as ISO string)

  player Player @relation(fields: [player_id], references: [id])

  @@unique([player_id, category, snapshot_date])
  @@index([snapshot_date])
  @@index([player_id])
  @@map("ranking_snapshots")
}

model PlayerCumulativeStats {
  id                  Int      @id @default(autoincrement())
  player_id           String   @unique

  // Combat
  attack_wins         Int      @default(0)
  defense_wins        Int      @default(0)
  total_attacks       Int      @default(0)
  total_defends       Int      @default(0)
  gold_stolen         BigInt   @default(0)
  fort_damage_dealt   Int      @default(0)
  units_killed        Int      @default(0)
  units_lost          Int      @default(0)

  // Spy
  spy_wins            Int      @default(0)
  counter_spy_wins    Int      @default(0)
  total_spy_ops       Int      @default(0)
  spies_lost          Int      @default(0)

  // Economy
  gold_spent          BigInt   @default(0)
  gold_income         BigInt   @default(0)

  // Army
  units_trained       Int      @default(0)

  // Social
  messages_sent       Int      @default(0)
  citizens_recruited  Int      @default(0)

  // Daily counters (reset by scheduler at midnight)
  daily_attack_wins   Int      @default(0)
  daily_defense_wins  Int      @default(0)
  daily_gold_stolen   BigInt   @default(0)
  daily_gold_income   BigInt   @default(0)
  daily_spy_wins      Int      @default(0)
  daily_units_trained Int      @default(0)
  daily_reset_at      DateTime?

  updated_at          DateTime @updatedAt

  player Player @relation(fields: [player_id], references: [id])

  @@map("player_cumulative_stats")
}

model AttackLog {
  id          Int       @id @default(autoincrement())
  attacker_id String
  defender_id String
  timestamp   DateTime?
  winner      String
  stats       String    // JSON stored as text for SQLite compat
  type        String    @default("attack")

  attacker       Player          @relation("attacker", fields: [attacker_id], references: [id])
  defender       Player          @relation("defender", fields: [defender_id], references: [id])
  acl            AttackLogAcl[]
  chatMessages   ChatMessage[]
  alliance_intel AllianceIntel[]

  @@index([attacker_id])
  @@index([defender_id])
  @@index([timestamp])
  @@map("attack_log")
}

model AttackLogAcl {
  id                    Int    @id @default(autoincrement())
  attack_log_id         Int
  shared_with_user_id   String?
  shared_with_alliance_id Int?

  attack_log AttackLog @relation(fields: [attack_log_id], references: [id])
  user       Player?   @relation(fields: [shared_with_user_id], references: [id])
  alliance   Alliance? @relation(fields: [shared_with_alliance_id], references: [id])

  @@map("attack_log_acl")
}

model BankHistory {
  id                Int    @id @default(autoincrement())
  gold_amount       BigInt
  from_user_id      String
  from_account_type String
  to_user_id        String
  to_account_type   String
  date_time         DateTime?
  history_type      String // BankTransferType
  stats             String?  @default("[]") // JSON stored as text

  @@index([from_user_id, to_user_id, date_time])
  @@map("bank_history")
}

model RecruitHistory {
  id        Int       @id @default(autoincrement())
  from_user String?
  to_user   String
  ip_addr   String
  timestamp DateTime?

  from_player Player? @relation("recruit_from", fields: [from_user], references: [id])
  to_player   Player  @relation("recruit_to", fields: [to_user], references: [id])

  @@index([to_user, from_user, timestamp])
  @@map("recruit_history")
}

model Social {
  id                Int      @id @default(autoincrement())
  player_id         String
  friend_id         String
  relationship_type String   // SocialRelationType: FRIEND, ALLY, ENEMY
  status            String   @default("REQUESTED") // SocialStatus
  request_date      DateTime @default(now())
  acceptance_date   DateTime?
  end_date          DateTime?

  player Player @relation("social_player", fields: [player_id], references: [id])
  friend Player @relation("social_friend", fields: [friend_id], references: [id])

  @@index([player_id])
  @@index([friend_id])
  @@map("social")
}

model Alliance {
  id                Int      @id @default(autoincrement())
  name              String
  leader_id         String
  avatar            String?
  motto             String?
  is_public         Boolean  @default(true)
  require_auth      Boolean  @default(false)
  closed_enrollment Boolean  @default(false)
  allow_bots        Boolean  @default(false) // Allow bots to auto-join this alliance
  gold_in_bank      BigInt?  @default(0)
  slug              String?
  banner_img        String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  leader      Player               @relation("alliance_leader", fields: [leader_id], references: [id])
  memberships AllianceMembership[]
  roles       AllianceRole[]
  attack_acl  AttackLogAcl[]
  chat_rooms  ChatRoom[]
  intel       AllianceIntel[]

  @@map("alliances")
}

model AllianceMembership {
  id          Int      @id @default(autoincrement())
  alliance_id Int
  user_id     String
  role_id     Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  alliance Alliance     @relation(fields: [alliance_id], references: [id])
  user     Player       @relation(fields: [user_id], references: [id])
  role     AllianceRole @relation(fields: [role_id], references: [id])

  @@unique([alliance_id, user_id])
  @@map("alliance_memberships")
}

model AllianceRole {
  id          Int      @id @default(autoincrement())
  name        String
  alliance_id Int
  permissions String?  @default("{\"canInvite\": false, \"canKick\": false, \"canManageRoles\": false, \"canManageBank\": false, \"canPostAnnouncements\": false}")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  alliance    Alliance             @relation(fields: [alliance_id], references: [id])
  memberships AllianceMembership[]

  @@map("alliance_roles")
}

model PermissionGrant {
  id         Int      @id @default(autoincrement())
  type       String   // PermissionType: ADMINISTRATOR, MODERATOR
  user_id    String
  created_at DateTime @default(now())

  user Player @relation(fields: [user_id], references: [id])

  @@map("permission_grants")
}

model PasswordReset {
  id                Int      @id @default(autoincrement())
  user_id           String
  verification_code String
  created_at        DateTime @default(now())
  status            Int      @default(0) // 0=Active, 1=Used, 2=Expired
  type              String   @default("PASSWORD")
  old_email         String?

  user Player @relation(fields: [user_id], references: [id])

  @@map("password_resets")
}

model AccountStatusHistory {
  id         Int      @id @default(autoincrement())
  user_id    String
  status     String   // AccountStatus
  start_date DateTime @default(now())
  end_date   DateTime?
  reason     String?
  admin_id   String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user  Player  @relation("status_user", fields: [user_id], references: [id])
  admin Player? @relation("status_admin", fields: [admin_id], references: [id])

  @@index([user_id, start_date])
  @@map("account_status_history")
}

model BlogPost {
  id           Int      @id @default(autoincrement())
  title        String
  content      String
  posted_by_id String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  posted_by       Player           @relation(fields: [posted_by_id], references: [id])
  post_read_status PostReadStatus[]

  @@map("blog_posts")
}

model PostReadStatus {
  post_id      Int
  user_id      String
  last_read_at DateTime

  post BlogPost @relation(fields: [post_id], references: [id])
  user Player   @relation(fields: [user_id], references: [id])

  @@id([post_id, user_id])
  @@map("post_read_status")
}

model ChatRoom {
  id            Int      @id @default(autoincrement())
  name          String?
  is_private    Boolean  @default(true)
  created_by_id String
  alliance_id   Int?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  created_by   Player              @relation(fields: [created_by_id], references: [id])
  alliance     Alliance?           @relation(fields: [alliance_id], references: [id])
  participants ChatRoomParticipant[]
  messages     ChatMessage[]

  @@map("chat_rooms")
}

model ChatRoomParticipant {
  id        Int      @id @default(autoincrement())
  room_id   Int
  user_id   String
  role      String   @default("MEMBER") // ChatRole: ADMIN, MEMBER
  can_write Boolean  @default(true)
  joined_at DateTime @default(now())

  room ChatRoom @relation(fields: [room_id], references: [id])
  user Player   @relation(fields: [user_id], references: [id])

  @@unique([room_id, user_id])
  @@map("chat_room_participants")
}

model ChatMessage {
  id            Int      @id @default(autoincrement())
  room_id       Int
  sender_id     String
  content       String
  message_type  String   @default("TEXT") // TEXT | SYSTEM | GAME_EVENT
  reply_to_id   Int?
  shared_log_id Int?
  sender_color  String?  // Hex color for name (cosmetic)
  sender_icon   String?  // Emoji or icon (cosmetic)
  sent_at       DateTime @default(now())

  room       ChatRoom              @relation(fields: [room_id], references: [id], onDelete: Cascade)
  sender     Player                @relation(fields: [sender_id], references: [id], onDelete: Cascade)
  reply_to   ChatMessage?          @relation("message_replies", fields: [reply_to_id], references: [id])
  replies    ChatMessage[]         @relation("message_replies")
  shared_log AttackLog?            @relation(fields: [shared_log_id], references: [id], onDelete: SetNull)
  reactions  ChatMessageReaction[]
  read_status ChatMessageReadStatus[]

  @@index([room_id, sent_at])
  @@map("chat_messages")
}

model ChatMessageReaction {
  id         Int      @id @default(autoincrement())
  message_id Int
  user_id    String
  reaction   String
  created_at DateTime @default(now())

  message ChatMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user    Player      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([message_id, user_id, reaction])
  @@map("chat_message_reactions")
}

model ChatMessageReadStatus {
  message_id Int
  user_id    String
  read_at    DateTime @updatedAt

  message ChatMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user    Player      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([message_id, user_id])
  @@index([user_id])
  @@map("chat_message_read_status")
}

model Mail {
  id         Int      @id @default(autoincrement())
  sender_id  String?
  subject    String
  body       String
  mail_type  String   // MailType: SYSTEM, PLAYER, ALLIANCE
  metadata   String?  // JSON stored as text for SQLite compat
  created_at DateTime @default(now())

  sender     Player?        @relation(fields: [sender_id], references: [id])
  recipients MailRecipient[]

  @@index([sender_id])
  @@index([created_at])
  @@map("mail")
}

model MailRecipient {
  id         Int       @id @default(autoincrement())
  mail_id    Int
  player_id  String
  is_read    Boolean   @default(false)
  is_deleted Boolean   @default(false)
  read_at    DateTime?

  mail   Mail   @relation(fields: [mail_id], references: [id], onDelete: Cascade)
  player Player @relation(fields: [player_id], references: [id])

  @@unique([mail_id, player_id])
  @@index([player_id, is_deleted, is_read])
  @@map("mail_recipients")
}

model JobLog {
  id                Int       @id @default(autoincrement())
  job_name          String    // "turn_tick", "daily_tick", "account_status"
  status            String    // "RUNNING", "COMPLETED", "FAILED"
  started_at        DateTime  @default(now())
  finished_at       DateTime?
  duration_ms       Int?
  players_processed Int       @default(0)
  error_message     String?
  details           String?   // JSON summary

  @@index([job_name, started_at])
  @@map("job_logs")
}

model MercenaryDailyPurchase {
  id         Int      @id @default(autoincrement())
  player_id  String
  unit_type  String   // OFFENSE, DEFENSE, SPY, SENTRY
  purchased  Int      @default(0)
  reset_date DateTime @default(now())

  player Player @relation(fields: [player_id], references: [id])

  @@unique([player_id, unit_type])
  @@map("mercenary_daily_purchases")
}

model BotConfig {
  id               Int       @id @default(autoincrement())
  player_id        String    @unique
  strategy         String    // BotStrategy: WARRIOR, TURTLE, ECONOMIST, SPYMASTER, BALANCED
  is_active        Boolean   @default(true)
  sessions_per_day Int       @default(3)
  last_session_at  DateTime?
  sessions_today   Int       @default(0)
  personality_seed Int       @default(0)
  notes            String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  player      Player         @relation(fields: [player_id], references: [id])
  action_logs BotActionLog[]
  snapshots   BotSnapshot[]

  @@index([is_active])
  @@map("bot_configs")
}

model BotActionLog {
  id            Int      @id @default(autoincrement())
  bot_config_id Int
  session_id    String
  action_type   String   // BotActionType enum
  action_data   String   // JSON params
  result_data   String?  // JSON result
  reasoning     String
  success       Boolean  @default(true)
  error_message String?
  created_at    DateTime @default(now())

  bot_config BotConfig @relation(fields: [bot_config_id], references: [id])

  @@index([bot_config_id, created_at])
  @@index([session_id])
  @@map("bot_action_logs")
}

model BotSnapshot {
  id               Int      @id @default(autoincrement())
  bot_config_id    Int
  snapshot_date    DateTime @default(now())

  // Economy
  gold             BigInt
  gold_in_bank     BigInt
  attack_turns     Int

  // Stats
  level            Int
  experience       BigInt
  offense          Int
  defense          Int
  spy              Int
  sentry           Int

  // Population
  citizens         Int
  workers          Int
  offense_units    Int
  defense_units    Int
  spy_units        Int
  sentry_units     Int
  total_population Int

  // Fort
  fort_level       Int
  fort_hp          Int
  fort_max_hp      Int

  // Buildings
  fortification_level    Int @default(1)
  armory_level           Int @default(0)
  mine_level             Int @default(0)
  spy_academy_level      Int @default(0)
  housing_level          Int @default(0)
  mercenary_camp_level   Int @default(0)

  // Chat activity (since last snapshot)
  chat_messages_sent Int @default(0)

  // Combat metrics (since last snapshot)
  attacks_won      Int    @default(0)
  attacks_lost     Int    @default(0)
  gold_stolen      BigInt @default(0)
  gold_lost        BigInt @default(0)

  // Equipment counts by tier
  weapons_t1       Int    @default(0)
  weapons_t2       Int    @default(0)
  weapons_t3       Int    @default(0)
  armor_t1         Int    @default(0)
  armor_t2         Int    @default(0)
  armor_t3         Int    @default(0)

  // Session metrics (since last snapshot)
  sessions_run     Int    @default(0)
  actions_performed Int   @default(0)
  actions_failed   Int    @default(0)

  bot_config       BotConfig @relation(fields: [bot_config_id], references: [id])

  @@index([bot_config_id, snapshot_date])
  @@map("bot_snapshots")
}

model AllianceIntel {
  id              Int      @id @default(autoincrement())
  alliance_id     Int
  target_id       String
  spied_by_id     String
  attack_log_id   Int
  reveal_percent  Int
  intel_data      String   // JSON snapshot (point-in-time display data)
  created_at      DateTime @default(now())

  alliance   Alliance  @relation(fields: [alliance_id], references: [id])
  target     Player    @relation("intel_target", fields: [target_id], references: [id])
  spied_by   Player    @relation("intel_spy", fields: [spied_by_id], references: [id])
  attack_log AttackLog @relation(fields: [attack_log_id], references: [id])

  @@index([alliance_id, target_id])
  @@index([attack_log_id])
  @@map("alliance_intel")
}

model ActivityLog {
  id            Int       @id @default(autoincrement())
  player_id     String
  activity_type String    // ActivityType enum
  target_id     String?
  reference_id  Int?      // link to attack_log.id etc.
  metadata      String?   // JSON text (SQLite compat)
  is_public     Boolean   @default(true)
  created_at    DateTime  @default(now())

  player  Player  @relation("activity_actor", fields: [player_id], references: [id])
  target  Player? @relation("activity_target", fields: [target_id], references: [id])

  @@index([player_id, created_at])
  @@index([created_at])
  @@map("activity_log")
}

// ─── Cosmetics Shop ──────────────────────────────────────────────────────────

model Cosmetic {
  id          String   @id @default(cuid())
  type        String   // CosmeticType: NAME_COLOR | ICON
  name        String   // Display name (e.g., "Royal Purple", "Crown")
  value       String   // Hex color or emoji/icon
  price       BigInt   // Gold cost
  description String?
  created_at  DateTime @default(now())

  player_cosmetics PlayerCosmetic[]

  @@map("cosmetics")
}

model PlayerCosmetic {
  id          Int      @id @default(autoincrement())
  player_id   String
  cosmetic_id String
  equipped    Boolean  @default(false)
  purchased_at DateTime @default(now())

  player   Player   @relation(fields: [player_id], references: [id], onDelete: Cascade)
  cosmetic Cosmetic @relation(fields: [cosmetic_id], references: [id], onDelete: Cascade)

  @@unique([player_id, cosmetic_id])
  @@index([player_id, equipped])
  @@map("player_cosmetics")
}

// ─── Game Settings (global configuration) ──────────────────────────────

model GameSettings {
  id                Int      @id @default(autoincrement())
  key               String   @unique // Setting key (e.g., 'bot_chat_enabled', 'turns_per_tick')
  value             String   // JSON-encoded value
  description       String?  // Human-readable description
  updated_at        DateTime @default(now()) @updatedAt
  updated_by_user_id String?  // Admin who last updated this setting

  @@map("game_settings")
}

// ─── Game Data Definitions (Cache-on-Boot) ──────────────────────────────────

model Unit {
  id          String   @id @default(cuid())
  type        String   // UnitType: CITIZEN, OFFENSE, DEFENSE, SPY, SENTRY
  level       Int
  name        String
  cost        BigInt

  // Stats (for display/comparison)
  bonus       Int      @default(0)     // Original bonus value (income for WORKER, combat for others)
  offense     Int      @default(0)
  defense     Int      @default(0)
  spy         Int      @default(0)
  sentry      Int      @default(0)

  // Requirements
  fort_level  Int      @default(1)     // Required fortification level
  building_requirements String? // JSON: [{ buildingType, level }]

  // Combat stats
  hp              Int @default(10)
  killing_strength Int @default(0)
  defense_strength Int @default(0)

  // Metadata
  enabled     Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([type, level])
  @@index([type, level])
  @@index([enabled])
  @@map("units")
}

model Item {
  id          String   @id @default(cuid())
  type        String   // ItemType: WEAPON, HELM, ARMOR, BOOTS, BRACERS, SHIELD
  usage       String   // ItemUsage: OFFENSE, DEFENSE, SPY, SENTRY
  level       Int      // Tier (1-10)
  name        String
  bonus       Int      // Stat bonus provided
  cost        BigInt

  // Requirements
  armory_level Int     @default(0)  // Required armory building level (0-5)
  race         String  @default("ALL") // Player race filter (ALL, UNDEAD, HUMAN, etc.)

  // Combat stats (currently unused but kept for future)
  killing_strength  Int @default(0)
  defense_strength  Int @default(0)

  // Metadata
  enabled     Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([type, usage, level])
  @@index([type, usage, level])
  @@index([enabled])
  @@map("items")
}

model Building {
  id                   String   @id @default(cuid())
  type                 String   // BuildingType: ARMORY, MERCENARY_CAMP, etc.
  level                Int
  name                 String
  cost                 BigInt

  // Requirements
  player_level_req     Int      @default(1)

  // Benefits
  workers_provided     Int?
  offense_bonus        Int      @default(0)
  defense_bonus        Int      @default(0)
  spy_bonus            Int      @default(0)
  sentry_bonus         Int      @default(0)
  income_bonus         Int      @default(0)
  max_item_bonus       Int?     // For ARMORY
  daily_merc_stock     Int?     // For MERCENARY_CAMP

  // Metadata
  enabled              Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@unique([type, level])
  @@index([type, level])
  @@index([enabled])
  @@map("buildings")
}

model Fortification {
  id                     String   @id @default(cuid())
  level                  Int      @unique
  name                   String
  max_population         Int
  max_land               Int
  price                  BigInt
  hitpoints              Int
  gold_per_turn          Int
  cost_per_repair_point  BigInt

  // Metadata
  enabled                Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@index([enabled])
  @@map("fortifications")
}

model BattleUpgrade {
  id          String   @id @default(cuid())
  type        String   // BattleUpgradeType: OFFENSE, DEFENSE, SPY, SENTRY
  level       Int
  name        String
  bonus       Int      // Stat bonus per unit
  cost        BigInt

  // Metadata
  enabled     Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([type, level])
  @@index([type, level])
  @@index([enabled])
  @@map("battle_upgrades")
}

model EconomyUpgrade {
  id          String   @id @default(cuid())
  type        String   // EconomyUpgradeType: OFFENSE, DEFENSE, SPY, SENTRY
  level       Int
  name        String
  bonus       Int      // Income bonus per unit
  cost        BigInt

  // Metadata
  enabled     Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([type, level])
  @@index([type, level])
  @@index([enabled])
  @@map("economy_upgrades")
}

model Race {
  id                String   @id // UNDEAD, HUMAN, GOBLIN, ELF
  name              String

  // Bonuses (multipliers, e.g., 1.5 = +50%)
  offense_bonus     Float    @default(0)
  defense_bonus     Float    @default(0)
  spy_bonus         Float    @default(0)
  sentry_bonus      Float    @default(0)
  income_bonus      Float    @default(0)
  recruit_bonus     Float    @default(0)

  // UI
  description       String?
  theme_color       String   @default("#6b46c1")

  // Metadata
  enabled           Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([enabled])
  @@map("races")
}

// ─── Saved Combat Simulations ───────────────────────────────────────────────

model SavedSimulation {
  id         String   @id @default(uuid())
  player_id  String
  title      String   // User-friendly title
  notes      String?  // Optional notes/observations
  input      String   // JSON: full battle configuration (attacker, defender, config, turnsUsed)
  result     String   // JSON: battle result (single or batch)
  runs       Int      @default(1) // 1 for single, 100/1000/10000 for batch
  created_at DateTime @default(now())

  player Player @relation(fields: [player_id], references: [id], onDelete: Cascade)

  @@index([player_id, created_at(sort: Desc)])
  @@map("saved_simulations")
}

// ─── Bot Intelligence (Phase 1) ─────────────────────────────────────────────

model BotIntelCache {
  id               String   @id @default(uuid())
  bot_id           String
  target_id        String
  target_name      String
  target_level     Int
  gold_amount      BigInt?  // Null if not revealed (spy/sentry ratio < 1.1x)
  offense_strength Int      // Estimated from units seen
  defense_strength Int      // Estimated from units seen
  spied_at         DateTime
  reveal_percent   Float    // How much info was revealed (0-100)

  bot Player @relation("BotIntelReports", fields: [bot_id], references: [id], onDelete: Cascade)

  @@unique([bot_id, target_id])
  @@index([bot_id, spied_at])
  @@map("bot_intel_cache")
}

model BotBattleMemory {
  id          String   @id @default(uuid())
  bot_id      String
  target_id   String
  target_name String
  is_win      Boolean
  gold_stolen BigInt
  units_lost  Int
  timestamp   DateTime @default(now())

  bot Player @relation("BotBattleHistory", fields: [bot_id], references: [id], onDelete: Cascade)

  @@index([bot_id, timestamp])
  @@index([bot_id, target_id, timestamp])
  @@map("bot_battle_memory")
}

model BotThreatTracking {
  id             String   @id @default(uuid())
  bot_id         String
  attacker_id    String
  attacker_name  String
  attacker_level Int
  gold_lost      BigInt
  timestamp      DateTime @default(now())

  bot Player @relation("BotThreats", fields: [bot_id], references: [id], onDelete: Cascade)

  @@index([bot_id, timestamp])
  @@index([bot_id, attacker_id, timestamp])
  @@map("bot_threat_tracking")
}

# Database
DATABASE_URL="postgresql://openthrone:openthrone@localhost:5432/openthrone?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# NextAuth (frontend)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"

# API
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# CAPTCHA (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_ID=""
TURNSTILE_SECRET=""

# Email (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@openthrone.dev"

# Feature Toggles
ENABLE_ATTACKING="false"
ENABLE_INTEL="true"
ENABLE_ASSASSINATIONS="false"
ENABLE_INFILTRATIONS="false"
ENABLE_MESSAGING="true"
ENABLE_REGISTRATION="true"

# Scheduled Jobs
ENABLE_TURN_UPDATES="true"
ENABLE_DAILY_UPDATES="true"
